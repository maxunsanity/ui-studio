--- a/src/tools/uxStudio/styles.css
+++ b/src/tools/uxStudio/styles.css
@@ -2662,3 +2662,28 @@
 .ui-control.control-tabs > button[aria-selected="true"]:not(.native-tab-skin) { box-shadow: inset 0 -3px 0 currentColor; }
 .ui-control.control-tabs > .native-tab-skin { border-radius: 0!important; outline: 0; }
 .ui-control.control-tabs > .native-tab-skin:focus-visible { outline: 2px solid #64717f; outline-offset: -2px; }
+
+/* Shared stage positions keep whole-screen, detail and guide navigation familiar. */
+.studio-current-screen{font-weight:600;overflow-wrap:anywhere;font-size:14px;margin-top:4px}
+.studio-navigation{gap:10px}
+.studio-stage-nav{display:flex;gap:6px;align-items:center;flex-wrap:wrap;min-width:0;flex:1}
+.studio-stage-nav a,.studio-stage-nav button{font:inherit;font-size:13px;border:1px solid transparent;border-radius:6px;padding:7px 9px;color:inherit;text-decoration:none;background:transparent}
+.studio-stage-nav a:hover,.studio-stage-nav button:hover{background:#28394c}
+.studio-stage-nav [aria-current=step]{border-color:#4e718d;background:#263e51;font-weight:600}
+.studio-stage-nav>span{color:#92a7ba}
+.studio-tools>div{max-height:min(70dvh,640px);overflow:auto}
+.studio-tools .inline{flex-wrap:wrap}
+.studio-header .save-controls{flex-wrap:wrap;justify-content:flex-end;gap:8px}
+.studio-screen-preview{width:min(1440px,calc(100vw - 24px));height:calc(100dvh - 24px);max-width:none;max-height:none;padding:0;border:1px solid #71859c;border-radius:12px;background:#17212d;color:#e5edf5}
+.studio-screen-preview::backdrop{background:#08121dcc}
+.studio-screen-preview[open]{display:flex;flex-direction:column}
+.studio-screen-preview>header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-bottom:1px solid #405064;flex:none}
+.studio-screen-preview>header>div{min-width:0}
+.studio-screen-preview h2{font-size:17px;line-height:1.4;margin:0;overflow-wrap:anywhere}
+.studio-screen-preview p{font-size:12px;color:#b7c8d8;margin:4px 0 0;overflow-wrap:anywhere}
+.studio-screen-preview-viewport{flex:1;min-height:0;min-width:0;overflow:auto;display:flex;align-items:center;justify-content:center;padding:12px}
+.studio-screen-preview-stage{position:relative;flex:none}
+.studio-screen-preview-host{position:absolute;top:0;left:0;transform-origin:0 0}
+.studio-screen-preview-host .sample-screen{position:relative;overflow:hidden;background:transparent}
+.studio-screen-preview-host .sample-panel{position:absolute;overflow:hidden}
+@media(max-width:760px){.studio-header .project-directory{font-size:11px}.studio-header .save-controls{justify-content:flex-start}.studio-navigation{align-items:flex-start}.studio-stage-nav{flex-basis:100%}.studio-stage-nav a,.studio-stage-nav button{padding:6px;font-size:12px}.studio-navigation .file-menu>div{right:0;max-width:calc(100vw - 24px)}.studio-screen-preview{width:calc(100vw - 12px);height:calc(100dvh - 12px)}.studio-screen-preview>header{align-items:flex-start;flex-wrap:wrap;padding:10px}}
