+function selectedImageConsumer(t,{selected=true,slice,hover=false}={}){
+ const root=fixture(t),create=document.createElement;
+ document.createElement=tag=>{const node=create(tag);node.style.setProperty=(key,value)=>{node.style[key]=value;};node.style.removeProperty=key=>{delete node.style[key];};return node;};
+ const design=stateDesign(),buttonData=design.screens[0].elements[0],config=buttonData.buttonState;
